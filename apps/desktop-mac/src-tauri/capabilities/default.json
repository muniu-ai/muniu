{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "deep-link:default",
    "dialog:allow-save",
    "opener:default",
    "process:allow-restart",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/mn-api",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" }
      ]
    }
  ]
}
