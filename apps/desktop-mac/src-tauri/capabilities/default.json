{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "木牛 Agent OS 主窗口的最小权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/mn-host",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
