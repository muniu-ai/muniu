{
  "name": "@mn/cli",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": "https://github.com/muniu-ai/muniu",
  "type": "module",
  "bin": {
    "mn": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js",
    "verify:migration-v3": "tsc -p tsconfig.test.json && node --test dist-test/test/migration-v3.test.js",
    "dev": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "@mn/agent-protocol": "0.2.0",
    "@mn/agent-session": "0.2.0",
    "@mn/api": "0.2.0",
    "@mn/app-server": "0.2.0",
    "@mn/app-server-protocol": "0.2.0",
    "@mn/core": "^0.2.0",
    "@mn/executors": "^0.2.0",
    "@mn/harness": "^0.2.0",
    "@mn/loop": "^0.2.0",
    "@mn/specs": "^0.2.0",
    "@mn/sdk": "0.2.0",
    "@mn/worker": "^0.2.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@mn/agent-kernel": "0.2.0"
  }
}
