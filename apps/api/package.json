{
  "name": "@mn/api",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": "https://github.com/muniu-ai/muniu",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js",
    "test:coverage:agent-session": "tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-include=dist-test/src/agentSession*.js --test-coverage-include=dist-test/src/agentApprovalCoordinator*.js --test-coverage-include=dist-test/src/agentRuntimeFactory*.js --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=70 dist-test/test/agentSessionRoutes.test.js dist-test/test/agentRuntimeFactory.test.js dist-test/test/agentProductionSession.test.js",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "1.4.0",
    "@mn/agent-llm": "0.1.1",
    "@mn/agent-host": "0.1.1",
    "@mn/agent-protocol": "0.1.1",
    "@mn/agent-session": "0.1.1",
    "@mn/agent-tools": "0.1.1",
    "@mn/config-manager": "0.1.1",
    "@mn/connectors": "0.1.1",
    "@mn/core": "0.1.1",
    "@mn/evidence": "0.1.1",
    "@mn/executors": "0.1.1",
    "@mn/extensions": "0.1.1",
    "@mn/governance": "0.1.1",
    "@mn/harness": "0.1.1",
    "@mn/local-proxy": "0.1.1",
    "@mn/loop": "0.1.1",
    "@mn/provider-catalog": "0.1.1",
    "@mn/runtime": "0.1.1",
    "@mn/specs": "0.1.1",
    "@mn/store": "0.1.1",
    "@mn/usage": "0.1.1",
    "@mn/worker": "0.1.1",
    "fastify": "^5.12.0",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
