# Runtime profile: local | enterprise
MN_RUNTIME_PROFILE=local
MN_API_HOST=127.0.0.1
MN_API_PORT=7318

# Enterprise profile (all required when MN_RUNTIME_PROFILE=enterprise)
MN_POSTGRES_URL=postgresql://mn:replace-me@localhost:5432/mn
MN_OIDC_ISSUER=https://id.example.com/
MN_OIDC_AUDIENCE=mn-enterprise
MN_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
MN_CORS_ALLOWLIST=https://mn.example.com
MN_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com/v1/traces
MN_OTEL_SERVICE_NAME=mn-api
MN_STANDARD_PACK_TRUST_FILE=/absolute/path/to/standard-pack-trust.json
# Comma-separated absolute repository roots; required and resolved with realpath.
MN_ENTERPRISE_PROJECT_ROOTS=/srv/mn/repos
# HMAC key (at least 32 bytes) used by the API to bind claims to enforced sandbox leases.
# Load this from the enterprise secret manager in production; never share it with workers.
MN_SANDBOX_ATTESTATION_KEY=replace-with-at-least-32-random-bytes
# JSON keyring with active/retired/revoked HMAC keys for immutable provider-usage journals.
MN_PROVIDER_USAGE_JOURNAL_INTEGRITY_FILE=/absolute/path/to/provider-usage-journal-integrity.json
# Governed provider proxy is started with the enterprise API. PUBLIC_BASE_URL
# must be reachable from remote workers; it must never use 0.0.0.0.
MN_ENTERPRISE_PROXY_HOST=0.0.0.0
MN_ENTERPRISE_PROXY_PORT=7319
MN_ENTERPRISE_PROXY_PUBLIC_BASE_URL=https://mn-provider-proxy.example.com

# CLI authentication. Supply a human JWT for interactive commands or a scoped
# principal_type=worker JWT for the queue worker protocol. Store the token outside this file.
MN_API_TOKEN=
# Product enterprise worker capability declaration. The machine JWT `sub` is
# used by default when MN_WORKER_ID is omitted.
MN_WORKER_ID=
MN_WORKER_PROVIDERS=claude,codex
MN_WORKER_LANGUAGES=javascript,typescript
MN_WORKER_GATE_RUNNERS=
MN_WORKER_TOOLS=node,npm
MN_WORKER_SANDBOX_BACKEND=enterprise-container
MN_WORKER_SANDBOX_CAPABILITIES=
# API selects the reference and verifies Docker's actual image ID against this
# SHA-256 trust anchor. Workers may assert the reference but cannot override it.
MN_ENTERPRISE_SANDBOX_IMAGE=node:22-alpine
MN_ENTERPRISE_SANDBOX_IMAGE_DIGEST=replace-with-docker-image-content-id-without-sha256-prefix
MN_DOCKER_BINARY=docker

# Local artifact store and optional remote mirror
MN_ARTIFACT_ROOT=.mn/artifacts
MN_ARTIFACT_STORE_MAX_BYTES=
MN_ARTIFACT_STORE_QUOTA_KEEP_LATEST_RUNS=1
MN_ARTIFACT_REMOTE_STORE_PATH=
MN_ARTIFACT_REMOTE_STORE_TYPE=filesystem
MN_ARTIFACT_REMOTE_STORE_BUCKET=
MN_ARTIFACT_REMOTE_STORE_PREFIX=
MN_ARTIFACT_REMOTE_STORE_ENDPOINT_URL=
MN_ARTIFACT_OBJECT_STORE_LOCAL_BACKEND_PATH=

# Required for an enterprise S3-compatible artifact store
MN_ARTIFACT_S3_REGION=us-east-1
MN_ARTIFACT_S3_ACCESS_KEY_ID=
MN_ARTIFACT_S3_SECRET_ACCESS_KEY=
MN_ARTIFACT_S3_SESSION_TOKEN=
MN_ARTIFACT_S3_REQUEST_TIMEOUT_MS=10000

# Local compatibility and executor settings
MN_API_AUTO_RESUME_RUNS=0
MN_API_AUTO_RESUME_PENDING_RUNS=0
MN_DEFAULT_PROVIDERS=claude,codex
